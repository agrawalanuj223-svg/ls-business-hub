erDiagram
    AUTH_USERS ||--|| PROFILES : has
    PROFILES ||--o{ USER_COMPANY_ROLES : receives
    COMPANIES ||--o{ USER_COMPANY_ROLES : grants
    COMPANIES ||--o{ BUSINESS_PARTNERS : owns
    BUSINESS_PARTNERS ||--o{ SERVICE_ORDERS : engages
    SERVICE_ORDERS ||--o{ BILLING_SCHEDULES : generates
    BUSINESS_PARTNERS ||--o{ INVOICES : billed
    SERVICE_ORDERS ||--o{ INVOICES : supports
    BILLING_SCHEDULES o|--o| INVOICES : links
    INVOICES ||--o{ PAYMENTS : receives
    COMPANIES ||--o{ DOCUMENTS : owns
    DOCUMENTS ||--o{ DOCUMENT_ACCESS : shares
    BUSINESS_PARTNERS ||--o{ DOCUMENT_ACCESS : receives
